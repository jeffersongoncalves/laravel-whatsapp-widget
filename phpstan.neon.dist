includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    ignoreErrors:
        # Package-namespaced view (whatsapp-widget::) isn't registered during analysis; only some Larastan versions flag it.
        -
            identifier: argument.type
            path: src/Http/Controllers/RedirectController.php
            reportUnmatched: false
    level: 5
    paths:
        - src
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: false
